{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "helios-cache",
	// Uzair's account, where the nix-cache Hyperdrive config lives.
	"account_id": "7b87b6b8f96465d53ec6ce256410c194",
	"main": "workers/cache/src/index.ts",
	"compatibility_date": "2026-03-10",
	// Required by the pg driver, which reaches Postgres through Hyperdrive.
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": true,
	"vars": {
		"SIGNING_KEY_NAME": "helios-cache-1"
	},
	"r2_buckets": [
		{
			"binding": "CACHE_BUCKET",
			"bucket_name": "helios-cache"
		},
		// Public caches, served straight from R2 and the CDN on cache.polmath.no;
		// every object in it is world-readable.
		{
			"binding": "PUBLIC_BUCKET",
			"bucket_name": "helios-public"
		}
	],
	// What authorization reads per request, cached at the edge: token
	// revocations, so checking a token never touches the database.
	"kv_namespaces": [
		{
			"binding": "AUTH_KV",
			"id": "d2e64836d5fa4888957d15bdd3370067"
		}
	],
	// Postgres (PlanetScale) through Hyperdrive. Create the config with query
	// caching off (`wrangler hyperdrive create helios-cache --caching-disabled
	// --connection-string ...`): upload sessions and token revocation must
	// read their own writes. Local runs connect directly via
	// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "fe5e1520e81649299506184e2116af05"
		}
	],
	// cache.polmath.no itself is the public bucket; the Worker takes only the
	// API and private caches there.
	"routes": [
		{ "pattern": "cache.polmath.no/_api/*", "zone_name": "polmath.no" },
		{ "pattern": "cache.polmath.no/private/*", "zone_name": "polmath.no" }
	],
	"triggers": {
		"crons": ["0 */6 * * *"]
	}
}
