{
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "name": "snowstead",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Cloudflare-native Nix binary cache",
  "scripts": {
    "build": "echo 'wrangler bundles at deploy time'",
    "deploy": "scripts/deploy.sh production",
    "dev": "scripts/dev.sh",
    "dev:profile": "scripts/dev-profile.sh",
    "check": "pnpm -r check && scripts/with-postgres.sh node --test packages/cache-core/integration/worker-split.mjs apps/cli/test/upload.test.mjs",
    "cf-typegen": "pnpm --filter @snowstead/cache-core cf-typegen && pnpm --filter @snowstead/gateway-worker cf-typegen"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
