{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                p.cache_id,\n                p.store_path_hash,\n                b.file_size\n            FROM UNNEST($1::integer[], $2::text[]) AS incoming(cache_id, hash)\n            JOIN published_paths p ON p.cache_id = incoming.cache_id\n                AND p.store_path_hash = incoming.hash\n            JOIN blob_objects b ON b.id = p.blob_object_id\n            ",
