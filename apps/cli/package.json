{
  "name": "@snowstead/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "snowstead": "../../target/release/snowstead"
  },
  "scripts": {
    "build": "cargo build --release --manifest-path Cargo.toml",
    "test": "cargo test --manifest-path Cargo.toml",
    "check": "cargo fmt --manifest-path Cargo.toml -- --check && cargo clippy --manifest-path Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path Cargo.toml"
  },
  "dependencies": {
    "@snowstead/cache-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
