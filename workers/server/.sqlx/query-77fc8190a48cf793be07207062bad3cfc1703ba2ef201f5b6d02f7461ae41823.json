{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    timestamp,\n                    actor,\n                    action,\n                    cache_name,\n                    status,\n                    detail,\n                    ip\n                FROM audit_logs\n                WHERE org_id = $1\n                    AND ($2::bigint IS NULL OR id < $2)\n                ORDER BY id DESC\n                LIMIT $3\n                ",
