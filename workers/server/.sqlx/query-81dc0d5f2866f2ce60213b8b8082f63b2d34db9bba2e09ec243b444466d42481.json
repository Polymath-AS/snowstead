{
  "db_name": "PostgreSQL",
  "query": "\n            WITH expired AS (\n                UPDATE go_entries\n                SET cache_id = NULL\n                WHERE cache_id = $1\n                    AND generation = $2\n                    AND action = $3\n                    AND expires_at <= NOW()\n            )\n            SELECT\n                e.id,\n                e.cache_id,\n                e.generation,\n                e.r2_key,\n                e.size,\n                e.output,\n                e.stored_at,\n                e.uploaded_at,\n                e.expires_at,\n                (e.last_accessed_at IS NULL OR e.last_accessed_at < NOW() - INTERVAL '5 minutes') AS \"access_due!\"\n            FROM go_entries e\n            WHERE e.cache_id = $1\n                AND e.generation = $2\n                AND e.action = $3\n                AND e.expires_at > NOW()\n            FOR UPDATE OF e NOWAIT\n            ",
