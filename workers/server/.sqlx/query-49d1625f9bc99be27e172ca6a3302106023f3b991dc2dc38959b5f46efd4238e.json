  "query": "\n            SELECT\n                o.slug,\n                o.moving_from,\n                c.name,\n                p.store_path_hash,\n                c.is_public\n            FROM published_paths p\n            JOIN caches c ON c.id = p.cache_id\n            JOIN orgs o ON o.id = c.org_id\n            WHERE p.id = ANY($1)\n            ",
