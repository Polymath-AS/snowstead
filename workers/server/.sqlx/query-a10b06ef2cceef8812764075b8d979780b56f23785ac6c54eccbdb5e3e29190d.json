  "query": "\n        UPDATE caches\n        SET is_public = COALESCE($2, is_public),\n            retention_days = CASE WHEN $3 THEN $4 ELSE retention_days END\n        WHERE id = $1\n        RETURNING is_public,\n            retention_days,\n            created_at\n        ",
