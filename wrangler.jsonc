{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "snowstead",
	"account_id": "a5af70f803f5950f325622198dbd50a2",
	"main": "workers/gateway/src/index.ts",
	"compatibility_date": "2026-03-10",
	"workers_dev": true,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
		"traces": { "enabled": true, "head_sampling_rate": 0.1 },
		"issues": { "enabled": true }
	},
	"vars": { "API_ORIGIN": "http://127.0.0.1:8787" },
	// Org reads bypass Workers. Keep the R2 CDN hostname unchanged and forward
	// only its legacy API paths to the Rust origin in production.
	"routes": [
		{ "pattern": "cache.snowstead.com/_api/*", "zone_name": "snowstead.com" }
	],
	// Explicitly remove the former monolith's scheduled maintenance at cutover.
	"triggers": { "crons": [] },
	"env": {
		"production": {
			"name": "snowstead",
			"workers_dev": false,
			"preview_urls": false,
			"vars": { "API_ORIGIN": "https://api.snowstead.com" }
		},
		"staging": {
			"name": "snowstead-staging",
			"workers_dev": false,
			"preview_urls": false,
			// Keep the production web gateway's wildcard off this existing host.
			"routes": [
				{ "pattern": "cache-staging.snowstead.com", "custom_domain": true },
				{ "pattern": "cache-staging.snowstead.com/*", "zone_name": "snowstead.com" }
			],
			// Supplied explicitly by scripts/deploy.sh; never use production here.
			"vars": { "API_ORIGIN": "" }
		}
	}
}
