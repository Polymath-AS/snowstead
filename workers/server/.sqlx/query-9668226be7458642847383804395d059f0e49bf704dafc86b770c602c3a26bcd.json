  "query": "\n            SELECT\n                id,\n                store_path_hash\n            FROM published_paths\n            WHERE cache_id = $1\n                AND created_at < $2\n                AND NOT nix_path_pinned(cache_id, store_path_hash, NOW())\n            ORDER BY created_at, id\n            LIMIT 500\n            ",
