{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id,\n            u.file_hash,\n            u.file_size,\n            u.compression,\n            u.status,\n            u.r2_upload_key,\n            u.r2_upload_id\n        FROM upload_sessions u\n        WHERE u.id = $1\n            AND u.expires_at <= now()\n            AND NOT EXISTS(\n                SELECT 1\n                FROM nar_installations i\n                WHERE i.source_key = u.r2_upload_key\n                    OR starts_with(i.source_key, 'staging/' || u.id || '/')\n            )\n        FOR UPDATE OF u NOWAIT\n        ",
