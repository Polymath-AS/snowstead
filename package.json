{
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "name": "snowstead",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Nix and compiler artifact cache",
  "scripts": {
    "build": "cargo build --locked --release -p snowstead-server -p snowstead-cli",
    "deploy": "scripts/deploy.sh production",
    "dev": "scripts/dev.sh",
    "check": "pnpm -r check && node --test workers/gateway/test/*.mjs",
    "cf-typegen": "pnpm --filter @snowstead/gateway-worker cf-typegen"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
