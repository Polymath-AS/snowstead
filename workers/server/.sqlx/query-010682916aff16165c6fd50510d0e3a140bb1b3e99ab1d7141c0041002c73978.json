{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.cache_id,\n            c.org_id,\n            c.name,\n            o.slug,\n            c.is_public,\n            p.store_path,\n            p.store_path_hash,\n            p.nar_hash,\n            p.nar_size,\n            p.references_json,\n            p.deriver,\n            p.system,\n            p.signatures_json,\n            b.file_hash,\n            b.file_size,\n            b.compression\n        FROM published_paths p\n        JOIN caches c ON c.id = p.cache_id\n        JOIN orgs o ON o.id = c.org_id\n        JOIN blob_objects b ON b.id = p.blob_object_id\n        WHERE p.id > $1\n        ORDER BY p.id\n        LIMIT $2\n        ",
