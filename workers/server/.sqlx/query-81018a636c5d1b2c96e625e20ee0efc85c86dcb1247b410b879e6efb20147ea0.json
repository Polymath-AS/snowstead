{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.current_revision,\n            r.store_path AS \"store_path?\"\n        FROM pins p\n        LEFT JOIN pin_revisions r ON r.pin_id = p.id\n            AND r.revision = p.current_revision\n        WHERE p.cache_id = $1\n            AND p.name = $2\n        ",
