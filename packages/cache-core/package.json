{
  "name": "@snowstead/cache-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "../../scripts/with-postgres.sh vitest run",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --config ../../workers/control/wrangler.jsonc",
    "check": "tsc --noEmit && ../../scripts/with-postgres.sh vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "~5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@snowstead/cache-domain": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "valibot": "^1.5.0"
  }
}
