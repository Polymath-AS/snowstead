{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    e.id,\n                    c.org_id,\n                    e.cache_id\n                FROM go_entries e\n                LEFT JOIN caches c ON c.id = e.cache_id\n                WHERE e.expires_at <= now()\n                    OR e.cache_id IS NULL\n                    OR e.generation <> c.go_generation\n                ORDER BY e.expires_at, e.id\n                LIMIT $1\n                ",
