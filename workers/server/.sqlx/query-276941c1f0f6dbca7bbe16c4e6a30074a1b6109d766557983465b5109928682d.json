  "db_name": "PostgreSQL",
  "query": "\n        SELECT *\n        FROM eviction_logs\n        WHERE org_id = $1\n            AND evicted_at > NOW() - INTERVAL '30 days'\n            AND ($2::bigint IS NULL OR id < $2)\n        ORDER BY id DESC\n        LIMIT $3\n        ",
