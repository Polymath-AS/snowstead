  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                p.store_path,\n                p.nar_hash,\n                p.nar_size,\n                p.references_json,\n                p.deriver,\n                p.system,\n                p.signatures_json,\n                b.file_hash,\n                b.file_size,\n                b.compression\n            FROM published_paths p\n            JOIN blob_objects b ON b.id = p.blob_object_id\n            WHERE p.cache_id = $1\n                AND p.store_path_hash = $2\n            ",
