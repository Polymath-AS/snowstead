{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.is_public,\n            o.slug,\n            o.moving_from,\n            c.name\n        FROM caches c\n        JOIN orgs o ON o.id = c.org_id\n        WHERE c.id = $1\n            AND c.org_id = $2\n            AND c.retention_days IS NOT NULL\n        FOR UPDATE OF c\n        ",
