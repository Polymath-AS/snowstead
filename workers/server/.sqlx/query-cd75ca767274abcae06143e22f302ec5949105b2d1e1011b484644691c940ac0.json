{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.is_public,\n            o.private_caches,\n            o.storage_limit\n        FROM caches c\n        JOIN orgs o ON o.id = c.org_id\n        WHERE c.org_id = $1\n            AND c.name = $2\n            AND EXISTS (\n                SELECT 1\n                FROM cache_protocols p\n                WHERE p.cache_id = c.id\n                    AND p.protocol = 'nix'\n            )\n        FOR SHARE OF c, o NOWAIT\n        ",
