{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.is_public,\n            o.slug,\n            o.moving_from\n        FROM caches c\n        JOIN orgs o ON o.id = c.org_id\n        WHERE c.org_id = $1\n            AND c.name = $2\n        FOR UPDATE OF c NOWAIT\n        ",
