{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    e.id,\n                    e.cache_id,\n                    e.generation,\n                    e.r2_key,\n                    e.size,\n                    NULL::text AS output,\n                    e.stored_at,\n                    e.uploaded_at,\n                    e.expires_at,\n                    (e.last_accessed_at IS NULL OR e.last_accessed_at < NOW() - INTERVAL '5 minutes') AS \"access_due!\"\n                FROM sccache_entries e\n                WHERE e.cache_id = $1\n                    AND e.generation = $2\n                    AND e.action = $3\n                    AND e.expires_at > NOW()\n                FOR UPDATE OF e NOWAIT\n                ",
