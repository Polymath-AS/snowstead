{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.store_path,\n            p.store_path_hash,\n            b.file_size,\n            p.nar_size,\n            p.created_at,\n            p.last_pushed_at\n        FROM published_paths p\n        JOIN blob_objects b ON b.id = p.blob_object_id\n        WHERE p.cache_id = $1\n            AND REGEXP_REPLACE(p.store_path, '^.*/', '') ILIKE $2\n            AND ($3::bigint IS NULL OR p.id < $3)\n        ORDER BY p.id DESC\n        LIMIT $4\n        ",
