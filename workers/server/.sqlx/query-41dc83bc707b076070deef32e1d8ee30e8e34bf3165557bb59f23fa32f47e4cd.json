{
  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO sccache_entries AS e (\n                id,\n                cache_id,\n                generation,\n                action,\n                r2_key,\n                size,\n                expires_at\n            )\n            VALUES ($1, $2, $3, $4, $5, $6, NOW() + INTERVAL '1 hour')\n            ON CONFLICT DO NOTHING\n            RETURNING\n                e.id,\n                e.cache_id,\n                e.generation,\n                e.r2_key,\n                e.size,\n                NULL::text AS output,\n                e.stored_at,\n                e.uploaded_at,\n                e.expires_at,\n                (e.last_accessed_at IS NULL OR e.last_accessed_at < NOW() - INTERVAL '5 minutes') AS \"access_due!\"\n            ",
