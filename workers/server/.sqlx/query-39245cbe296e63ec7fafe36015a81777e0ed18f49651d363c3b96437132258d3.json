  "query": "SELECT s.staged AS \"staged!\",p.session_id AS \"session_id?\",p.part_number AS \"part_number?\",p.size AS \"size?\" FROM (SELECT COALESCE(SUM(u.file_size),0)::bigint AS staged FROM upload_sessions u JOIN caches c ON c.id=u.cache_id WHERE c.org_id=$3 AND u.expires_at>NOW() AND u.status IN ('streaming','finalizing')) s LEFT JOIN (SELECT p.session_id,p.part_number,p.size FROM upload_parts p JOIN UNNEST($1::text[],$2::integer[]) r(session_id,part_number) USING(session_id,part_number)) p ON TRUE",
