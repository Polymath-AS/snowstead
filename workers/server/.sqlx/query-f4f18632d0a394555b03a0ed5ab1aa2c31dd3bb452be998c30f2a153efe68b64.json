{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    c.id AS cache_id,\n                    c.org_id AS org,\n                    c.is_public AS public,\n                    c.go_generation AS generation,\n                    c.created_at,\n                    $3::text AS \"action!\"\n                FROM caches c\n                JOIN orgs o ON o.id = c.org_id\n                WHERE o.slug = $1\n                    AND c.name = $2\n                    AND EXISTS (\n                        SELECT 1\n                        FROM cache_protocols p\n                        WHERE p.cache_id = c.id\n                            AND p.protocol = 'go'\n                    )\n                ",
