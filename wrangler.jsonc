{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "snowstead",
	"account_id": "a5af70f803f5950f325622198dbd50a2",
	"main": "workers/gateway/src/index.ts",
	"compatibility_date": "2026-03-10",
	"workers_dev": true,
	"preview_urls": false,
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
		"traces": { "enabled": true, "head_sampling_rate": 0.4 },
		"issues": { "enabled": true }
	},
	"services": [
		{ "binding": "NIX", "service": "snowstead-nix" },
		{ "binding": "GO", "service": "snowstead-go" },
		{ "binding": "CONTROL", "service": "snowstead-control" }
	],
	// Public Nix objects still bypass Workers through the R2 custom domain/CDN.
	"routes": [
		{ "pattern": "cache.snowstead.com/_api/*", "zone_name": "snowstead.com" },
		{ "pattern": "cache.snowstead.com/private/*", "zone_name": "snowstead.com" }
	],
	// Explicitly remove the former monolith's scheduled maintenance at cutover.
	"triggers": { "crons": [] },
	"env": {
		"production": {
			"name": "snowstead",
			"services": [
				{ "binding": "NIX", "service": "snowstead-nix" },
				{ "binding": "GO", "service": "snowstead-go" },
				{ "binding": "CONTROL", "service": "snowstead-control" }
			]
		},
		"staging": {
			"name": "snowstead-staging",
			"workers_dev": false,
			"routes": [{ "pattern": "cache-staging.snowstead.com", "custom_domain": true }],
			"services": [
				{ "binding": "NIX", "service": "snowstead-staging-nix" },
				{ "binding": "GO", "service": "snowstead-staging-go" },
				{ "binding": "CONTROL", "service": "snowstead-staging-control" }
			]
		}
	}
}
