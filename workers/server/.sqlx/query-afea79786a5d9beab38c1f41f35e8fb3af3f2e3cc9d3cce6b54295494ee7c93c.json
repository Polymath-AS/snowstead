  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            c.org_id,\n            c.name,\n            o.slug,\n            p.store_path_hash\n        FROM published_paths p\n        JOIN caches c ON c.id = p.cache_id\n        JOIN orgs o ON o.id = c.org_id\n        WHERE p.id > $1\n        ORDER BY p.id\n        LIMIT $2\n        ",
