{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.org_id,\n            c.is_public,\n            o.slug\n        FROM caches c\n        JOIN orgs o ON o.id = c.org_id\n        WHERE c.name = $1\n            AND (o.slug = $2 OR o.moving_from = $2)\n            AND EXISTS (\n                SELECT 1\n                FROM cache_protocols cp\n                WHERE cp.cache_id = c.id\n                    AND cp.protocol = 'nix'\n            )\n        ",
